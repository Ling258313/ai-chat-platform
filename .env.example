# OpenAI 兼容 API 配置
#
# 【重要】请复制为 .env.development.local,不要复制为 .env.local
#   .env.development.local  只在 pnpm dev(开发模式)加载,不进构建产物
#   .env.local              dev 和 build 都会加载,pnpm build 时 Key 会被写进 dist/*.js,等于公开泄漏
#
# 原理:Vite 在构建时会把 import.meta.env.VITE_* 静态替换成字面量字符串,
#       所以任何 VITE_ 开头的变量都会出现在前端产物里,一律不要放敏感信息。
#       项目已在 stores/settings.ts 加 import.meta.env.DEV 守卫做第二层防护。

# API 地址,例如:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   https://api.moonshot.cn/v1
#   https://localhost:11434/v1  (Ollama)
VITE_API_BASE_URL=

# API Key
VITE_API_KEY=

# 默认模型
#   OpenAI:  gpt-4o-mini / gpt-4o
#   DeepSeek: deepseek-chat / deepseek-reasoner
#   Moonshot: moonshot-v1-8k
#   Ollama:   llama3 / qwen2.5
VITE_MODEL=
