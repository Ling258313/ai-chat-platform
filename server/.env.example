
# 复制本文件为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 启动命令已带 --env-file-if-exists=.env，不需要 dotenv 这类依赖。

# 服务监听端口
PORT=3000

# 上游 OpenAI 兼容接口地址（结尾不要带斜杠）
UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# ★ 大模型密钥。只存在于服务端，永远不会下发到浏览器
UPSTREAM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 前端没指定 model 时使用的默认模型
DEFAULT_MODEL=deepseek-chat

# 允许跨域的前端来源，多个用英文逗号分隔。生产环境只填自己的域名
CORS_ORIGINS=http://localhost:5173
